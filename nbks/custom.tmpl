<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,100..900;1,100..900&family=Noto+Sans+Mono:wght@100..900&family=Source+Serif+4:ital,wght@0,200..900;1,200..900&family=Spline+Sans+Mono:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">
    <style type="text/css">
      @import url("observable:styles/index.css");
      /* point the notebook kit's font variables at the network-loaded families */
      :root {
        --serif: "Source Serif 4", ui-serif, serif;
        --sans-serif: "Inter", ui-sans-serif, sans-serif;
        --monospace: "Spline Sans Mono", Menlo, Consolas, monospace;
      }
      /* force no margin even in the html tag */
      * {
        margin-top:0 !important;
      }
      /* change this for overall background color */
      html {
        background-color: rgb(30,30,30);
        margin:0;
        padding:2vw; /* change this to 0 to override default */
        border:0;
      }
      /* and also this for body properties */
      body {
        background-color: rgb(30,30,30);
        max-width: none;
        margin:0;
        padding:0;
        border:0;
      }
      /* Caroline's friend Orange's CSS which they called 'shadows' */

      /* #metrics {
        font-family: 'Noto Sans Mono', 'Andale Mono', monospace;
        font-weight: bold;
        font-size: calc((96vw / 42) * 1.66);
      } */

      /* #display {
        color: #09348e;
        position: relative;
        min-height: 1.5em;
        padding-top: .2em;
      } */

      #line {
        font-family: 'Noto Sans Mono', 'Andale Mono', monospace;
        /* font-weight: bold; */
        z-index: 1;
        white-space: break-spaces;
        font-size: calc((96vw / 42) * 1.66); /* calc((96vw / 42) * 1.6); */ /* 4vw; */
        color: white; /* #09348e; */
        /* zero-height row whose top edge is the text baseline, centered in the viewport.
           --len (longest line, in characters) is set from the notebook. */
        position: fixed;
        top: 50%;
        left: 0;
        right: 0;
        height: 0;
        width: calc(var(--len, 0) * 1ch);
        margin-inline: auto;
        transform: translateX(-1ch); /* glyphs start at left: 1ch */
      }

      #line span {
        position: absolute;
        width: 1ch;
        /* border: 1px dashed black; */
        /* border: 1px dashed red; */
      }

      /* trim only the bottom of each glyph box to the baseline, then lift it so the baseline sits on #line's top edge */
      #line span.text {
        text-box: trim-end text alphabetic;
        transform: translateY(-100%);
      }

      /* keep the :before box at its original size: 90% of the untrimmed 1.5em line box */
      #line span.text:before {
        top: .075em;
        height: 1.35em;
      }

      #line span.redact {
      	display: inline-block;
        transform: scaleY(.8);
      }

      .text {
        color: rgba(255,255,255,.85);
        text-shadow: rgba(160,64,255,1) 0 0 .75ch; /* EDIT IF NEEDED */
        transition: text-shadow 60ms ease-in-out, opacity 60ms ease-in-out;
      }

      .text.visible {
        opacity: 1;
        font-stretch: normal;
        /* text-shadow: red 0 0 1.5ch; */
        /* #09348e */
      }

      .text.invisible {
        opacity: 0;
        font-stretch: expanded;
        /* text-shadow: #09348e 0 0 1.5ch; */
      }

      .text.visible:before {
        position: absolute;
        z-index: 1;
        top: 5%; left: 5%;
        width: 90%;
        height: 90%;
        background: linear-gradient(#eeeeff00, #eeeeff00, #eeeeff30, #eeeeff00);
        content: '';
        border: 1px solid #333;
      }

      .text.invisible:before {
        position: absolute;
        z-index: 1;
        top: 5%; left: 5%;
        width: 90%;
        height: 90%;
        background: linear-gradient(#ffeeee00, #ffeeee30, #ffeeee00, #ffeeee00);
        content: '';
        border: 1px solid #333;
      }
    </style>
  </head>
  <body>
    <main></main>
  </body>
</html>
